{
  "name": "order-mgmt-cap",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/cds-common-content": "^3",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "eslint": "^10.14.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint ."
  },
  "private": true,
  "description": "Order management on SAP BTP — CAP Node.js, OData V4, Fiori Elements, XSUAA, HANA Cloud, S/4HANA integration via Destination service",
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "OrderManager"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": [
                "OrderViewer"
              ]
            },
            "carol": {
              "password": "carol",
              "roles": []
            }
          }
        }
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "[production]": {
          "credentials": {
            "destination": "S4_BUPA",
            "path": "/sap/opu/odata/sap/API_BUSINESS_PARTNER"
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      },
      "html5-repo": true
    }
  }
}
